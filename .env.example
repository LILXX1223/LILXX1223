# Copy to .env locally. Never commit secrets or real patient information.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-before-deployment
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# AI API configuration and the API Key are entered through the admin UI.
# Optional Fernet master key; leave empty to use the local 0600 master-key file.
ICU_AI_ENCRYPTION_KEY=
# Explicit institutional authorization gates for external data.
AI_HOSPITAL_AUTHORIZED=false
AI_PERSONNEL_EXTERNAL_AUTHORIZED=false
# Optional synthetic-only simulation for isolated tests, not a real connection.
ICU_AI_ALLOW_MOCK=false
